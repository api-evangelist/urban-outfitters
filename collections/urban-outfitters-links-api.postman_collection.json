                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetUrl\": \"<string>\",\n  \"affiliateId\": \"<string>\"\n}",
