{
  "opencollection": "1.0.0",
  "info": {
    "name": "Urban Outfitters Affiliate Creatives Shipments API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Shipments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Urban Outfitters Create Shipment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.rakutenadvertising.com/v1/orders/:order_id/shipments",
            "params": [
              {
                "name": "order_id",
                "value": "order-xyz789",
                "type": "path",
                "description": "The order identifier"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit shipment tracking information for a fulfilled marketplace order."
        }
      ]
    }
  ],
  "bundled": true
}